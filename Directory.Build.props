<Project>
  <!-- Tootega AIAD: locations used by every Visual Studio project of the repository (MSBuild imports this
       file by itself for each project below this folder, the forks under deps\forks included). -->
  <PropertyGroup>
    <AiadRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</AiadRoot>
    <!-- For string literals in C++ (forward slashes, no escapes). -->
    <AiadRootFwd>$(AiadRoot.Replace('\', '/'))</AiadRootFwd>
    <AiadDeps>$(AiadRoot)deps\</AiadDeps>
    <!-- CUDA 13.3 (the version the prebuilt MFEM was built with); override with /p:AiadCuda=... -->
    <AiadCuda Condition="'$(AiadCuda)' == '' and '$(CUDA_PATH_V13_3)' != ''">$(CUDA_PATH_V13_3)\</AiadCuda>
    <AiadCuda Condition="'$(AiadCuda)' == ''">$(CUDA_PATH)\</AiadCuda>
    <!-- Python 3 for Aurora's shader packing scripts (the py launcher of python.org installs). -->
    <AiadPython Condition="'$(AiadPython)' == ''">py -3</AiadPython>
  </PropertyGroup>
</Project>
