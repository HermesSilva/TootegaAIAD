diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4162042..1a77fa4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -742,7 +742,12 @@ if (MINGW)
   target_link_libraries(mfem PRIVATE ws2_32)
 endif()
 if (MSVC)
-  target_compile_options(mfem PUBLIC "/wd4819")
+  # 4AIAD: with CUDA the option must not reach nvcc as a bare argument (nvcc then sees two
+  # input files); forward it to the host compiler instead.
+  target_compile_options(mfem PUBLIC "$<$<COMPILE_LANGUAGE:CXX>:/wd4819>"
+                                     "$<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=/wd4819>")
+  # 4AIAD: M_PI and friends are only defined by MSVC's <cmath> with _USE_MATH_DEFINES.
+  target_compile_definitions(mfem PUBLIC _USE_MATH_DEFINES)
 endif()
 message(STATUS "TPL_INCLUDE_DIRS = ${TPL_INCLUDE_DIRS}")
 target_include_directories(mfem
