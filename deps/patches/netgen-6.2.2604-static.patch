diff --git a/CMakeLists.txt b/CMakeLists.txt
index f6c09a9..ce9c103 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -47,6 +47,11 @@ set(NG_COMPILE_FLAGS "" CACHE STRING "Additional compile flags")
 set(NGLIB_LIBRARY_TYPE SHARED CACHE STRING "nglib library type")
 set(NGCORE_LIBRARY_TYPE SHARED CACHE STRING "ngcore library type")
 set(NGGUI_LIBRARY_TYPE SHARED CACHE STRING "nggui library type")
+# 4AIAD: static libraries need NETGEN_STATIC in Netgen itself and in every consumer.
+if(WIN32 AND NGLIB_LIBRARY_TYPE STREQUAL "STATIC" AND NGCORE_LIBRARY_TYPE STREQUAL "STATIC")
+  add_compile_definitions(NETGEN_STATIC)
+  set(NETGEN_STATIC_DEFINITION NETGEN_STATIC)
+endif()
 
 set(CMAKE_MODULE_PATH "${CMAKE_MODULE_PATH}" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/cmake_modules")
 
