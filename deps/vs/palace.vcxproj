<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Palace (fork palace-4AIAD): its CMake superbuild (MS-MPI, flang for ARPACK-NG, about 20 minutes the
       first time) driven by deps\_src\build_palace.bat; installs into deps\palace\cpu. Not part of the
       solution build: build this project explicitly. Needs the MS-MPI SDK and LLVM flang (deps\README.md). -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6E1C7A52-3B0F-4D47-9C3E-5F2A8B4D1C70}</ProjectGuid>
    <RootNamespace>palace</RootNamespace>
    <Keyword>MakeFileProj</Keyword>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(AiadDeps)palace\cpu\bin\</OutDir>
    <IntDir>$(AiadRoot)_build\$(Configuration)\obj\$(ProjectName)\</IntDir>
    <NMakeBuildCommandLine>cmd /c "$(AiadDeps)_src\build_palace.bat" cpu</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>cmd /c "$(AiadDeps)_src\build_palace.bat" cpu</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>cmd /c rmdir /s /q "$(AiadDeps)_build\palace-cpu"</NMakeCleanCommandLine>
    <NMakeOutput>$(AiadDeps)palace\cpu\bin\palace-x86_64.bin</NMakeOutput>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\_src\build_palace.bat" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
