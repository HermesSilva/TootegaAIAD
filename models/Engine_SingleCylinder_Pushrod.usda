 },
 {
  \"description\": \"\",
  \"name\": \"groove\",
  \"unit\": \"m\",
  \"value\": \"0.0035 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"piston_inner_r\",
  \"unit\": \"m\",
  \"value\": \"piston_r - 0.0045 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"liner_out\",
  \"unit\": \"m\",
  \"value\": \"R + 0.0035 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"barrel_wall\",
  \"unit\": \"m\",
  \"value\": \"R + 0.008 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"fin_r\",
  \"unit\": \"m\",
  \"value\": \"R + 0.030 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"head_r\",
  \"unit\": \"m\",
  \"value\": \"R + 0.012 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"leg_in\",
  \"unit\": \"m\",
  \"value\": \"magneto_flywheel_radius + magneto_air_gap\"
 },
 {
  \"description\": \"\",
  \"name\": \"yoke_in\",
  \"unit\": \"m\",
  \"value\": \"leg_in + magneto_leg_length\"
 },
 {
  \"description\": \"\",
  \"name\": \"yoke_out\",
  \"unit\": \"m\",
  \"value\": \"yoke_in + magneto_yoke_thickness\"
 },
 {
  \"description\": \"\",
  \"name\": \"plug_x\",
  \"unit\": \"m\",
