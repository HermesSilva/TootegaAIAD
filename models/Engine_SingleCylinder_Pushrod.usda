 },
 {
  \"description\": \"\",
  \"name\": \"timing_width\",
  \"unit\": \"m\",
  \"value\": \"0.012 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"flywheel_z1\",
  \"unit\": \"m\",
  \"value\": \"flywheel_z0 + flywheel_width\"
 },
 {
  \"description\": \"\",
  \"name\": \"flywheel_z0\",
  \"unit\": \"m\",
  \"value\": \"rotor_z1 + 0.008\"
 },
 {
  \"description\": \"\",
  \"name\": \"piston_r\",
  \"unit\": \"m\",
