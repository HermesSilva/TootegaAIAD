    def Scope "Elements"
    {
        def Scope "Crank_friction_and_load"
        {
            custom string aiad:definition = '{"constant":"0.97e5 * bore^2 * stroke / 16","joint":"Main bearing","linear":"0.15e5 * bore^2 * stroke / 16 * 30 / (pi * 1000)","quadratic":"0.05e5 * bore^2 * stroke / 16 * (30 / (pi * 1000))^2 + load_coefficient"}'
            custom string aiad:name = "Crank friction and load"
            custom string aiad:type = "load"
        }

        def Scope "Crank_to_idler"
        {
            custom string aiad:definition = '{"joint0":"Main bearing","joint1":"Idler bearing","part0":"Crank timing gear","part1":"Idler gear"}'
            custom string aiad:name = "Crank to idler"
            custom string aiad:type = "gear"
        }

        def Scope "Idler_to_cam"
        {
            custom string aiad:definition = '{"joint0":"Idler bearing","joint1":"Camshaft bearing","part0":"Idler gear","part1":"Cam timing gear"}'
            custom string aiad:name = "Idler to cam"
            custom string aiad:type = "gear"
        }

        def Scope "Intake_cam"
        {
            custom string aiad:definition = '{"body":"IntakeTappet","normal":[-1,0,0],"part":"Intake lobe","point":["tappet_bottom_x","pushrod_y","valve_offset_z"],"radius":"0.011 * s"}'
            custom string aiad:name = "Intake cam"
            custom string aiad:type = "contact"
        }

        def Scope "Exhaust_cam"
        {
            custom string aiad:definition = '{"body":"ExhaustTappet","normal":[-1,0,0],"part":"Exhaust lobe","point":["tappet_bottom_x","pushrod_y","-valve_offset_z"],"radius":"0.011 * s"}'
            custom string aiad:name = "Exhaust cam"
            custom string aiad:type = "contact"
        }

        def Scope "Intake_rocker"
        {
            custom string aiad:definition = '{"body":"IntakeValve","normal":[1,0,0],"part":"Intake rocker arm","point":["valve_tip_x",0,"valve_offset_z"],"radius":"stem_r"}'
            custom string aiad:name = "Intake rocker"
            custom string aiad:type = "contact"
        }

        def Scope "Exhaust_rocker"
        {
            custom string aiad:definition = '{"body":"ExhaustValve","normal":[1,0,0],"part":"Exhaust rocker arm","point":["valve_tip_x",0,"-valve_offset_z"],"radius":"stem_r"}'
            custom string aiad:name = "Exhaust rocker"
            custom string aiad:type = "contact"
        }

        def Scope "Intake_valve_spring"
        {
            custom string aiad:definition = '{"body0":"Frame","body1":"IntakeValve","free_length":"spring_free_length","part":"Intake valve spring","point0":["head_top_x",0,"valve_offset_z"],"point1":["head_top_x + spring_length",0,"valve_offset_z"]}'
            custom string aiad:name = "Intake valve spring"
            custom string aiad:type = "spring"
        }

        def Scope "Exhaust_valve_spring"
        {
            custom string aiad:definition = '{"body0":"Frame","body1":"ExhaustValve","free_length":"spring_free_length","part":"Exhaust valve spring","point0":["head_top_x",0,"-valve_offset_z"],"point1":["head_top_x + spring_length",0,"-valve_offset_z"]}'
            custom string aiad:name = "Exhaust valve spring"
            custom string aiad:type = "spring"
        }

        def Scope "Magneto"
        {
            custom string aiad:definition = '{"coil":"Magneto coil","core":["Magneto core leg A","Magneto core leg B","Magneto core yoke"],"magnet":"Magnet (ferrite)","points_open":"points_open_deg","rotor":"Main bearing","shoes":["Pole shoe A","Pole shoe B"]}'
            custom string aiad:name = "Magneto"
            custom string aiad:type = "magneto"
        }

        def Scope "Cylinder"
        {
            custom string aiad:definition = '{"crank":"Main bearing","cylinder":"Cylinder liner","exhaust":[{"joint":"Exhaust valve guide","part":"Exhaust valve"}],"head":"Cylinder head","ignition":"Magneto","intake":[{"joint":"Intake valve guide","part":"Intake valve"}],"piston":"Piston bore"}'
            custom string aiad:name = "Cylinder"
            custom string aiad:type = "chamber"
        }
