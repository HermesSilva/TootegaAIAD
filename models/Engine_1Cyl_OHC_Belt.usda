 },
 {
  "description": "",
  "name": "case_wall",
  "unit": "m",
  "value": "0.007 * s"
 },
 {
  "description": "",
  "name": "case_outer_r",
  "unit": "m",
  "value": "case_inner_r + case_wall"
 },
 {
  "description": "",
  "name": "case_inner_z",
  "unit": "m",
  "value": "web_out + 0.004"
 },
 {
  "description": "",
  "name": "case_outer_z",
  "unit": "m",
  "value": "case_inner_z + case_wall"
 },
 {
  "description": "Cylinder deck from the crank axis",
  "name": "deck_x",
  "unit": "m",
  "value": "r + rod_length + compression_height + clearance_height"
 },
 {
  "description": "",
  "name": "head_height",
  "unit": "m",
  "value": "0.042 * s"
 },
 {
  "description": "",
  "name": "head_top_x",
  "unit": "m",
  "value": "deck_x + head_height"
 },
 {
  "description": "",
  "name": "valve_offset_z",
  "unit": "m",
  "value": "0.2375 * bore"
 },
 {
  "description": "",
  "name": "spring_length",
  "unit": "m",
  "value": "0.038 * s"
 },
 {
  "description": "Valve spring free length",
  "name": "spring_free_length",
  "unit": "m",
  "value": "spring_length + spring_preload * s"
 },
 {
  "description": "",
  "name": "stem_r",
  "unit": "m",
  "value": "0.0035 * s"
 },
 {
  "description": "Valve tip above the deck (closed)",
  "name": "tip_rel",
  "unit": "m",
  "value": "head_height + spring_length + 0.005 * s"
 },
 {
  "description": "",
  "name": "bucket_top_rel",
  "unit": "m",
  "value": "tip_rel + 0.004 * s"
 },
 {
  "description": "",
  "name": "cam_centre_x",
  "unit": "m",
  "value": "deck_x + bucket_top_rel + valve_lash + cam_base_radius"
 },
 {
  "description": "Crank angle at which the magnet faces the core",
  "name": "magnet_mount_deg",
  "unit": "deg",
  "value": "mod(360 - spark_advance - points_open_deg, 360)"
 },
 {
  "description": "Magnet centre on the rotor (from +X)",
  "name": "magnet_centre",
  "unit": "deg",
  "value": "90 - magnet_mount_deg"
 },
 {
  "description": "",
  "name": "rotor_z0",
  "unit": "m",
  "value": "case_outer_z + 0.010"
 },
 {
  "description": "",
  "name": "rotor_z1",
  "unit": "m",
  "value": "rotor_z0 + magneto_stack_depth"
 },
 {
  "description": "",
  "name": "rotor_rim_in",
  "unit": "m",
  "value": "magneto_flywheel_radius - magneto_assembly_depth"
 },
 {
  "description": "",
  "name": "hub_r",
  "unit": "m",
  "value": "journal_r + 0.008 * s"
 },
 {
  "description": "",
  "name": "timing_z",
  "unit": "m",
  "value": "-(case_outer_z + timing_belt_offset)"
 },
 {
  "description": "",
  "name": "timing_width",
  "unit": "m",
  "value": "0.012 * s"
 },
 {
  "description": "",
  "name": "flywheel_z1",
  "unit": "m",
  "value": "timing_z - timing_width / 2 - 0.006"
 },
 {
  "description": "",
  "name": "flywheel_z0",
  "unit": "m",
  "value": "flywheel_z1 - flywheel_width"
 },
 {
  "description": "",
  "name": "piston_r",
  "unit": "m",
  "value": "R - 0.0003"
 },
 {
  "description": "",
  "name": "groove",
  "unit": "m",
  "value": "0.0035 * s"
 },
 {
  "description": "",
  "name": "piston_inner_r",
  "unit": "m",
  "value": "piston_r - 0.0045 * s"
 },
 {
  "description": "",
  "name": "liner_out",
  "unit": "m",
  "value": "R + 0.0035 * s"
 },
 {
  "description": "",
  "name": "barrel_wall",
  "unit": "m",
  "value": "R + 0.008 * s"
 },
 {
  "description": "",
  "name": "fin_r",
  "unit": "m",
  "value": "R + 0.030 * s"
 },
 {
  "description": "",
  "name": "head_r",
  "unit": "m",
  "value": "R + 0.012 * s"
 },
 {
  "description": "",
  "name": "cover_top",
  "unit": "m",
  "value": "cam_centre_x + cam_base_radius + max(intake_lift, exhaust_lift) + 0.010 * s"
 },
 {
  "description": "",
  "name": "leg_in",
  "unit": "m",
  "value": "magneto_flywheel_radius + magneto_air_gap"
 },
 {
  "description": "",
  "name": "yoke_in",
  "unit": "m",
  "value": "leg_in + magneto_leg_length"
 },
 {
  "description": "",
  "name": "yoke_out",
  "unit": "m",
  "value": "yoke_in + magneto_yoke_thickness"
 },
 {
  "description": "",
  "name": "plug_x",
  "unit": "m",
  "value": "deck_x + 0.001"
 },
 {
  "description": "",
  "name": "plug_y",
  "unit": "m",
  "value": "0.021 * s"
 },
 {
  "description": "Spark plug axis (35 deg in the XY plane)",
  "name": "plug_c",
  "unit": "",
  "value": "cos(35)"
 },
 {
  "description": "",
  "name": "plug_s",
  "unit": "",
  "value": "sin(35)"
 },
 {
  "description": "",
  "name": "port_x",
  "unit": "m",
  "value": "deck_x + 0.016 * s"
 },
 {
  "description": "",
  "name": "port_back",
  "unit": "m",
  "value": "R + 0.004 * s"
 }
]'''
