 },
 {
  "description": "",
  "name": "web_out",
  "unit": "m",
  "value": "web_in + 0.013 * s"
 },
 {
  "description": "",
  "name": "counterweight_r",
  "unit": "m",
  "value": "0.046 * s"
 },
 {
  "description": "",
  "name": "big_end_outer",
  "unit": "m",
  "value": "crank_pin_r + 0.0095 * s"
 },
 {
  "description": "",
  "name": "case_inner_r",
  "unit": "m",
