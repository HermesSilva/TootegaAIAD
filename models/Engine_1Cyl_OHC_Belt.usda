 },
 {
  "description": "",
  "name": "journal_r",
  "unit": "m",
  "value": "0.016 * s"
 },
 {
  "description": "",
  "name": "wrist_pin_r",
  "unit": "m",
  "value": "0.009 * s"
 },
 {
  "description": "",
  "name": "big_end_half",
  "unit": "m",
  "value": "0.0105 * s"
 },
 {
  "description": "",
  "name": "web_in",
  "unit": "m",
