[
  {"comment": "Single-cylinder four-stroke engine, OHC, 2 valves, flywheel magneto. The drawing: parameters, formulas, materials, bodies and parts as feature histories. Mechanism frame: crank axis Z, cylinder axis +X; the model is turned upright (X -> world Z). Lengths in metres, angles in degrees."},

  {"command": "aiad_parameter_define", "args": {"name": "bore", "value": 0.08, "unit": "m", "min": 0.04, "max": 0.12, "description": "Cylinder bore"}},
  {"command": "aiad_parameter_define", "args": {"name": "stroke", "value": 0.06, "unit": "m", "min": 0.03, "max": 0.12, "description": "Piston stroke (twice the crank radius)"}},
  {"command": "aiad_parameter_define", "args": {"name": "rod_length", "value": 0.1, "unit": "m", "min": 0.06, "max": 0.25, "description": "Connecting rod, centre to centre"}},
  {"command": "aiad_parameter_define", "args": {"name": "compression_ratio", "value": 10, "unit": "", "min": 6, "max": 14, "description": "Geometric compression ratio (sets the chamber height)"}},
  {"command": "aiad_parameter_define", "args": {"name": "intake_valve_diameter", "value": 0.032, "unit": "m", "min": 0.015, "max": 0.05, "description": "Intake valve head diameter"}},
  {"command": "aiad_parameter_define", "args": {"name": "exhaust_valve_diameter", "value": 0.028, "unit": "m", "min": 0.015, "max": 0.05, "description": "Exhaust valve head diameter"}},
  {"command": "aiad_parameter_define", "args": {"name": "intake_open", "value": 350, "unit": "deg", "min": 300, "max": 380, "description": "Intake opens (crank angle of the 720 deg cycle, 0 = firing TDC)"}},
  {"command": "aiad_parameter_define", "args": {"name": "intake_close", "value": 580, "unit": "deg", "min": 520, "max": 640, "description": "Intake closes"}},
  {"command": "aiad_parameter_define", "args": {"name": "intake_lift", "value": 0.008, "unit": "m", "min": 0.003, "max": 0.012, "description": "Intake cam lobe lift"}},
  {"command": "aiad_parameter_define", "args": {"name": "exhaust_open", "value": 140, "unit": "deg", "min": 100, "max": 180, "description": "Exhaust opens"}},
  {"command": "aiad_parameter_define", "args": {"name": "exhaust_close", "value": 370, "unit": "deg", "min": 340, "max": 420, "description": "Exhaust closes"}},
  {"command": "aiad_parameter_define", "args": {"name": "exhaust_lift", "value": 0.008, "unit": "m", "min": 0.003, "max": 0.012, "description": "Exhaust cam lobe lift"}},
  {"command": "aiad_parameter_define", "args": {"name": "cam_base_radius", "value": 0.016, "unit": "m", "min": 0.01, "max": 0.025, "description": "Cam base circle radius"}},
  {"command": "aiad_parameter_define", "args": {"name": "flywheel_outer_radius", "value": 0.095, "unit": "m", "min": 0.06, "max": 0.14, "description": "Steel flywheel outer radius"}},
  {"command": "aiad_parameter_define", "args": {"name": "flywheel_inner_radius", "value": 0.06, "unit": "m", "min": 0.02, "max": 0.12, "description": "Steel flywheel rim inner radius"}},
  {"command": "aiad_parameter_define", "args": {"name": "flywheel_width", "value": 0.034, "unit": "m", "min": 0.01, "max": 0.06, "description": "Steel flywheel width"}},
  {"command": "aiad_parameter_define", "args": {"name": "timing_belt_offset", "value": 0.016, "unit": "m", "description": "Timing belt plane from the crankcase wall"}},
  {"command": "aiad_parameter_define", "args": {"name": "exhaust_pipe_side", "value": 0.075, "unit": "m", "description": "Exhaust pipe sideways run"}},
  {"command": "aiad_parameter_define", "args": {"name": "exhaust_pipe_back", "value": 0.04, "unit": "m", "description": "Exhaust pipe run behind the section plane"}},
  {"command": "aiad_parameter_define", "args": {"name": "spark_advance", "value": 25, "unit": "deg", "min": 0, "max": 45, "description": "Ignition before TDC (sets where the magnet sits on the flywheel)"}},
  {"command": "aiad_parameter_define", "args": {"name": "points_open_deg", "value": -3, "unit": "deg", "description": "Magnet angle from the core axis at which the breaker points open (optimum from the magneto field table)"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_flywheel_radius", "value": 0.075, "unit": "m", "description": "Magneto rotor radius (same geometry as the field solver)"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_assembly_depth", "value": 0.012, "unit": "m", "description": "Radial thickness of the magnet and pole shoes"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_segment_angle", "value": 10, "unit": "deg", "description": "Angular width of the magnet and of each shoe"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_air_gap", "value": 0.0005, "unit": "m", "description": "Air gap between rotor and core legs"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_leg_width", "value": 0.008, "unit": "m", "description": "Core leg width"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_leg_length", "value": 0.035, "unit": "m", "description": "Core leg length (air gap to yoke)"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_yoke_thickness", "value": 0.01, "unit": "m", "description": "Core yoke thickness"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_stack_depth", "value": 0.025, "unit": "m", "description": "Core stack depth (field solver Lz)"}},
  {"command": "aiad_parameter_define", "args": {"name": "magneto_remanence", "value": 0.4, "unit": "T", "description": "Magnet remanence Br (ferrite)"}},
  {"command": "aiad_parameter_define", "args": {"name": "load_coefficient", "value": 0.00025, "unit": "N m s^2", "min": 0, "max": 0.002, "description": "Study: propeller-like load T = k omega^2"}},
  {"command": "aiad_parameter_define", "args": {"name": "starter_stall_torque", "value": 50, "unit": "N m", "min": 5, "max": 200, "description": "Study: starter stall torque at the crank"}},
  {"command": "aiad_parameter_define", "args": {"name": "starter_free_speed", "value": 800, "unit": "rpm", "min": 200, "max": 3000, "description": "Study: starter free speed at the crank"}},
  {"command": "aiad_parameter_define", "args": {"name": "starter_duration", "value": 1, "unit": "s", "min": 0.2, "max": 5, "description": "Study: starter engaged time"}},

  {"comment": "Derived dimensions (formulas): transverse sizes scale with the bore."},
  {"command": "aiad_parameter_define", "args": {"name": "s", "value": "bore / 0.080", "description": "Scale of the transverse sizes"}},
  {"command": "aiad_parameter_define", "args": {"name": "R", "value": "bore / 2", "unit": "m", "description": "Bore radius"}},
  {"command": "aiad_parameter_define", "args": {"name": "r", "value": "stroke / 2", "unit": "m", "description": "Crank radius"}},
  {"command": "aiad_parameter_define", "args": {"name": "compression_height", "value": "0.30 * bore", "unit": "m", "description": "Wrist pin axis to piston crown"}},
  {"command": "aiad_parameter_define", "args": {"name": "skirt", "value": "0.26 * bore", "unit": "m", "description": "Skirt below the wrist pin"}},
  {"command": "aiad_parameter_define", "args": {"name": "clearance_height", "value": "stroke / (compression_ratio - 1)", "unit": "m", "description": "Flat chamber height at TDC"}},
  {"command": "aiad_parameter_define", "args": {"name": "crank_pin_r", "value": "0.015 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "journal_r", "value": "0.016 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "wrist_pin_r", "value": "0.009 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "big_end_half", "value": "0.0105 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "web_in", "value": "big_end_half + 0.0006", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "web_out", "value": "web_in + 0.013 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "counterweight_r", "value": "0.046 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "big_end_outer", "value": "crank_pin_r + 0.0095 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "case_inner_r", "value": "max(counterweight_r, r + big_end_outer) + 0.006 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "case_wall", "value": "0.007 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "case_outer_r", "value": "case_inner_r + case_wall", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "case_inner_z", "value": "web_out + 0.004", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "case_outer_z", "value": "case_inner_z + case_wall", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "deck_x", "value": "r + rod_length + compression_height + clearance_height", "unit": "m", "description": "Cylinder deck from the crank axis"}},
  {"command": "aiad_parameter_define", "args": {"name": "head_height", "value": "0.042 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "head_top_x", "value": "deck_x + head_height", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "valve_offset_z", "value": "0.2375 * bore", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "spring_length", "value": "0.038 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "stem_r", "value": "0.0035 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "tip_rel", "value": "head_height + spring_length + 0.005 * s", "unit": "m", "description": "Valve tip above the deck (closed)"}},
  {"command": "aiad_parameter_define", "args": {"name": "bucket_top_rel", "value": "tip_rel + 0.004 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "cam_centre_x", "value": "deck_x + bucket_top_rel + cam_base_radius", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "magnet_mount_deg", "value": "mod(360 - spark_advance - points_open_deg, 360)", "unit": "deg", "description": "Crank angle at which the magnet faces the core"}},
  {"command": "aiad_parameter_define", "args": {"name": "magnet_centre", "value": "90 - magnet_mount_deg", "unit": "deg", "description": "Magnet centre on the rotor (from +X)"}},
  {"command": "aiad_parameter_define", "args": {"name": "rotor_z0", "value": "case_outer_z + 0.010", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "rotor_z1", "value": "rotor_z0 + magneto_stack_depth", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "rotor_rim_in", "value": "magneto_flywheel_radius - magneto_assembly_depth", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "hub_r", "value": "journal_r + 0.008 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "timing_z", "value": "-(case_outer_z + timing_belt_offset)", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "timing_width", "value": "0.012 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "flywheel_z1", "value": "timing_z - timing_width / 2 - 0.006", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "flywheel_z0", "value": "flywheel_z1 - flywheel_width", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "piston_r", "value": "R - 0.0003", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "groove", "value": "0.0035 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "piston_inner_r", "value": "piston_r - 0.0045 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "liner_out", "value": "R + 0.0035 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "barrel_wall", "value": "R + 0.008 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "fin_r", "value": "R + 0.030 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "head_r", "value": "R + 0.012 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "cover_top", "value": "cam_centre_x + cam_base_radius + max(intake_lift, exhaust_lift) + 0.010 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "leg_in", "value": "magneto_flywheel_radius + magneto_air_gap", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "yoke_in", "value": "leg_in + magneto_leg_length", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "yoke_out", "value": "yoke_in + magneto_yoke_thickness", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "plug_x", "value": "deck_x + 0.001", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "plug_y", "value": "0.021 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "plug_c", "value": "cos(35)", "description": "Spark plug axis (35 deg in the XY plane)"}},
  {"command": "aiad_parameter_define", "args": {"name": "plug_s", "value": "sin(35)"}},
  {"command": "aiad_parameter_define", "args": {"name": "port_x", "value": "deck_x + 0.016 * s", "unit": "m"}},
  {"command": "aiad_parameter_define", "args": {"name": "port_back", "value": "R + 0.004 * s", "unit": "m"}},

  {"comment": "Materials: density drives the masses, the rest the appearance."},
  {"command": "aiad_material_define", "args": {"name": "Cast aluminium A356", "density": 2680, "colour": [0.80, 0.81, 0.82], "metallic": 1, "roughness": 0.42}},
  {"command": "aiad_material_define", "args": {"name": "Forged aluminium 4032", "density": 2690, "colour": [0.88, 0.88, 0.89], "metallic": 1, "roughness": 0.24}},
  {"command": "aiad_material_define", "args": {"name": "Steel 42CrMo4", "density": 7850, "colour": [0.64, 0.65, 0.67], "metallic": 1, "roughness": 0.28}},
  {"command": "aiad_material_define", "args": {"name": "Steel, black oxide", "density": 7850, "colour": [0.22, 0.22, 0.24], "metallic": 1, "roughness": 0.38}},
  {"command": "aiad_material_define", "args": {"name": "Grey cast iron", "density": 7200, "colour": [0.38, 0.38, 0.40], "metallic": 1, "roughness": 0.55}},
  {"command": "aiad_material_define", "args": {"name": "Bearing bronze", "density": 8800, "colour": [0.78, 0.56, 0.32], "metallic": 1, "roughness": 0.30}},
  {"command": "aiad_material_define", "args": {"name": "Copper winding", "density": 8960, "colour": [0.80, 0.45, 0.24], "metallic": 1, "roughness": 0.30}},
  {"command": "aiad_material_define", "args": {"name": "Alumina ceramic", "density": 3900, "colour": [0.93, 0.93, 0.91], "metallic": 0, "roughness": 0.18}},
  {"command": "aiad_material_define", "args": {"name": "Rubber", "density": 1200, "colour": [0.05, 0.05, 0.06], "metallic": 0, "roughness": 0.75}},
  {"command": "aiad_material_define", "args": {"name": "Ferrite magnet", "density": 4900, "colour": [0.17, 0.17, 0.19], "metallic": 0, "roughness": 0.55}},
  {"command": "aiad_material_define", "args": {"name": "Spark", "density": 0, "colour": [1.0, 0.85, 0.45], "metallic": 0, "roughness": 0.5, "emission": 25}},

  {"comment": "Rigid bodies and their rest placement in the mechanism frame."},
  {"command": "aiad_doc_orient", "args": {"axis": [0, 1, 0], "angle": -90}},
  {"command": "aiad_body_define", "args": {"body": "Frame", "origin": [0, 0, 0]}},
  {"command": "aiad_body_define", "args": {"body": "Crankshaft", "origin": [0, 0, 0]}},
  {"command": "aiad_body_define", "args": {"body": "Rod", "origin": [0, 0, 0]}},
  {"command": "aiad_body_define", "args": {"body": "Piston", "origin": [0, 0, 0]}},
  {"command": "aiad_body_define", "args": {"body": "Camshaft", "origin": ["cam_centre_x", 0, 0]}},
  {"command": "aiad_body_define", "args": {"body": "IntakeValve", "origin": ["deck_x", 0, "valve_offset_z"]}},
  {"command": "aiad_body_define", "args": {"body": "ExhaustValve", "origin": ["deck_x", 0, "-valve_offset_z"]}},
  {"command": "aiad_body_define", "args": {"body": "IntakeSpring", "origin": ["head_top_x", 0, "valve_offset_z"]}},
  {"command": "aiad_body_define", "args": {"body": "ExhaustSpring", "origin": ["head_top_x", 0, "-valve_offset_z"]}},

  {"comment": "Crankshaft (crank axis Z)."},
  {"command": "aiad_part_create", "args": {"name": "Main journal (magneto side)", "body": "Crankshaft", "material": "Steel 42CrMo4", "features": [
    {"op": "cylinder", "base": [0, 0, "web_out"], "axis": [0, 0, 1], "radius": "journal_r", "height": "rotor_z1 + 0.012 - web_out"}]}},
  {"command": "aiad_part_create", "args": {"name": "Main journal (timing side)", "body": "Crankshaft", "material": "Steel 42CrMo4", "features": [
    {"op": "cylinder", "base": [0, 0, "flywheel_z0 - 0.010"], "axis": [0, 0, 1], "radius": "journal_r", "height": "-web_out - flywheel_z0 + 0.010"}]}},
  {"command": "aiad_part_create", "args": {"name": "Crank pin", "body": "Crankshaft", "material": "Steel 42CrMo4", "features": [
    {"op": "cylinder", "base": ["r", 0, "-web_in"], "axis": [0, 0, 1], "radius": "crank_pin_r", "height": "2 * web_in"}]}},
  {"command": "aiad_part_create", "args": {"name": "Crank web (magneto side)", "body": "Crankshaft", "material": "Steel 42CrMo4", "features": [
    {"op": "extrude", "plane": "XY", "start": "web_in", "distance": "web_out - web_in", "profile": {"hull": {"circles": [
      {"center": [0, 0], "radius": "journal_r + 0.011 * s"}, {"center": ["r", 0], "radius": "crank_pin_r + 0.006 * s"},
      {"center": [0, 0], "radius": "counterweight_r", "from": 135, "to": 225}]}}}]}},
  {"command": "aiad_part_create", "args": {"name": "Crank web (timing side)", "body": "Crankshaft", "material": "Steel 42CrMo4", "features": [
    {"op": "extrude", "plane": "XY", "start": "-web_out", "distance": "web_out - web_in", "profile": {"hull": {"circles": [
      {"center": [0, 0], "radius": "journal_r + 0.011 * s"}, {"center": ["r", 0], "radius": "crank_pin_r + 0.006 * s"},
      {"center": [0, 0], "radius": "counterweight_r", "from": 135, "to": 225}]}}}]}},
  {"command": "aiad_part_create", "args": {"name": "Magneto rotor", "body": "Crankshaft", "material": "Cast aluminium A356", "features": [
    {"op": "revolve", "plane": "XZ", "profile": [
      ["journal_r", "rotor_z0 - 0.004"], ["hub_r", "rotor_z0 - 0.004"], ["hub_r", "rotor_z0 + 0.004"], ["rotor_rim_in - 0.004", "rotor_z0 + 0.004"],
      ["rotor_rim_in - 0.004", "rotor_z0"], ["rotor_rim_in", "rotor_z0"], ["rotor_rim_in", "rotor_z1"], ["rotor_rim_in - 0.004", "rotor_z1"],
      ["rotor_rim_in - 0.004", "rotor_z0 + 0.010"], ["hub_r", "rotor_z0 + 0.010"], ["hub_r", "rotor_z1 + 0.008"], ["journal_r", "rotor_z1 + 0.008"]]}]}},
  {"command": "aiad_part_create", "args": {"name": "Magnet (ferrite)", "body": "Crankshaft", "material": "Ferrite magnet", "role": "magnet", "features": [
    {"op": "revolve", "plane": "XZ", "profile": {"rect": {"min": ["rotor_rim_in", "rotor_z0"], "max": ["magneto_flywheel_radius", "rotor_z1"]}},
     "start_angle": "magnet_centre - magneto_segment_angle / 2", "angle": "magneto_segment_angle"}]}},
  {"command": "aiad_part_create", "args": {"name": "Pole shoe A", "body": "Crankshaft", "material": "Steel, black oxide", "features": [
    {"op": "revolve", "plane": "XZ", "profile": {"rect": {"min": ["rotor_rim_in", "rotor_z0"], "max": ["magneto_flywheel_radius", "rotor_z1"]}},
     "start_angle": "magnet_centre - 1.5 * magneto_segment_angle", "angle": "magneto_segment_angle"}]}},
  {"command": "aiad_part_create", "args": {"name": "Pole shoe B", "body": "Crankshaft", "material": "Steel, black oxide", "features": [
    {"op": "revolve", "plane": "XZ", "profile": {"rect": {"min": ["rotor_rim_in", "rotor_z0"], "max": ["magneto_flywheel_radius", "rotor_z1"]}},
     "start_angle": "magnet_centre + 0.5 * magneto_segment_angle", "angle": "magneto_segment_angle"}]}},
  {"command": "aiad_part_create", "args": {"name": "Rotor rim", "body": "Crankshaft", "material": "Cast aluminium A356", "features": [
    {"op": "revolve", "plane": "XZ", "profile": {"rect": {"min": ["rotor_rim_in", "rotor_z0"], "max": ["magneto_flywheel_radius", "rotor_z1"]}},
     "start_angle": "magnet_centre + 1.5 * magneto_segment_angle", "angle": "360 - 3 * magneto_segment_angle"}]}},
  {"command": "aiad_part_create", "args": {"name": "Rotor nut", "body": "Crankshaft", "material": "Steel, black oxide", "features": [
    {"op": "extrude", "plane": "XY", "start": "rotor_z1 + 0.008", "distance": 0.010, "profile": {"polygon": {"center": [0, 0], "across_flats": "0.024 * s", "sides": 6}}}]}},
  {"command": "aiad_part_create", "args": {"name": "Crank sprocket", "body": "Crankshaft", "material": "Steel, black oxide", "features": [
    {"op": "extrude", "plane": "XY", "start": "timing_z - timing_width / 2", "distance": "timing_width", "profile": {"sprocket": {"root_radius": "0.0185 * s", "tip_radius": "0.0215 * s", "teeth": 18}}}]}},
  {"command": "aiad_part_create", "args": {"name": "Flywheel (steel)", "body": "Crankshaft", "material": "Steel 42CrMo4", "role": "flywheel", "features": [
    {"op": "revolve", "plane": "XZ", "profile": [
      ["journal_r", "flywheel_z0"], ["flywheel_outer_radius", "flywheel_z0"], ["flywheel_outer_radius", "flywheel_z1"], ["flywheel_inner_radius", "flywheel_z1"],
      ["flywheel_inner_radius", "flywheel_z0 + 0.010"], ["journal_r + 0.012", "flywheel_z0 + 0.010"], ["journal_r + 0.012", "flywheel_z1"], ["journal_r", "flywheel_z1"]]}]}},

  {"comment": "Connecting rod (rod frame: crank pin at the origin, small end on +X)."},
