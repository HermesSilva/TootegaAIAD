 },
 {
  \"description\": \"\",
  \"name\": \"flywheel_z1\",
  \"unit\": \"m\",
  \"value\": \"flywheel_z0 + flywheel_width\"
 },
 {
  \"description\": \"\",
  \"name\": \"flywheel_z0\",
  \"unit\": \"m\",
