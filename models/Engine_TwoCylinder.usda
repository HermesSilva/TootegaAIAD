 },
 {
  \"description\": \"\",
  \"name\": \"piston_r\",
  \"unit\": \"m\",
  \"value\": \"R - 0.0003\"
 },
 {
  \"description\": \"\",
  \"name\": \"groove\",
  \"unit\": \"m\",
  \"value\": \"0.0035 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"piston_inner_r\",
  \"unit\": \"m\",
  \"value\": \"piston_r - 0.0045 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"liner_out\",
  \"unit\": \"m\",
  \"value\": \"R + 0.0035 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"barrel_wall\",
  \"unit\": \"m\",
  \"value\": \"R + 0.008 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"fin_r\",
  \"unit\": \"m\",
  \"value\": \"R + 0.030 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"head_r\",
  \"unit\": \"m\",
  \"value\": \"R + 0.012 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"leg_in\",
  \"unit\": \"m\",
  \"value\": \"magneto_flywheel_radius + magneto_air_gap\"
 },
 {
  \"description\": \"\",
  \"name\": \"yoke_in\",
  \"unit\": \"m\",
  \"value\": \"leg_in + magneto_leg_length\"
 },
 {
  \"description\": \"\",
  \"name\": \"yoke_out\",
  \"unit\": \"m\",
  \"value\": \"yoke_in + magneto_yoke_thickness\"
 },
 {
  \"description\": \"\",
  \"name\": \"plug_x\",
  \"unit\": \"m\",
  \"value\": \"deck_x + 0.001\"
 },
 {
  \"description\": \"\",
  \"name\": \"plug_y\",
  \"unit\": \"m\",
  \"value\": \"0.021 * s\"
 },
 {
  \"description\": \"Spark plug axis (35 deg in the XY plane)\",
  \"name\": \"plug_c\",
  \"unit\": \"\",
  \"value\": \"cos(35)\"
 },
 {
  \"description\": \"\",
  \"name\": \"plug_s\",
  \"unit\": \"\",
  \"value\": \"sin(35)\"
 },
 {
  \"description\": \"\",
  \"name\": \"port_x\",
  \"unit\": \"m\",
  \"value\": \"deck_x + 0.016 * s\"
 },
 {
  \"description\": \"\",
  \"name\": \"port_back\",
  \"unit\": \"m\",
  \"value\": \"R + 0.004 * s\"
 },
 {
  \"description\": \"Lateral plane of the front cylinder's pushrods and tappets: they stand on the central camshaft, between the cylinders (the rear ones are its mirror about the V bisector)\",
  \"name\": \"pushrod_y\",
  \"unit\": \"m\",
  \"value\": \"cam_rho * bis_s\"
 },
 {
  \"description\": \"Rocker arm ratio (valve arm / pushrod arm): the valve lifts this times the tappet\",
  \"max\": 1.8,
  \"min\": 0.8,
  \"name\": \"rocker_ratio\",
  \"unit\": \"\",
  \"value\": 1
 },
 {
  \"description\": \"Central camshaft centre along the front cylinder axis (on the V bisector)\",
  \"name\": \"cam_x\",
  \"unit\": \"m\",
  \"value\": \"cam_rho * bis_c\"
 },
 {
  \"description\": \"Valve stem tip (closed) along the cylinder axis\",
  \"name\": \"valve_tip_x\",
  \"unit\": \"m\",
  \"value\": \"deck_x + tip_rel\"
 },
 {
  \"description\": \"Rocker shaft axis height\",
  \"name\": \"rocker_pivot_x\",
  \"unit\": \"m\",
  \"value\": \"valve_tip_x + 0.010 * s\"
 },
 {
  \"description\": \"Rocker shaft lateral position (between valve and pushrod, from the ratio)\",
  \"name\": \"rocker_pivot_y\",
  \"unit\": \"m\",
  \"value\": \"pushrod_y * rocker_ratio / (1 + rocker_ratio)\"
 },
 {
  \"description\": \"Tappet face on the cam base circle\",
  \"name\": \"tappet_bottom_x\",
  \"unit\": \"m\",
  \"value\": \"cam_x + cam_base_radius\"
 },
 {
  \"description\": \"Tappet top (pushrod seat centre)\",
  \"name\": \"tappet_top_x\",
  \"unit\": \"m\",
  \"value\": \"tappet_bottom_x + 0.028 * s\"
 },
 {
  \"description\": \"Adjusting screw ball end (pushrod upper cup centre)\",
  \"name\": \"adjuster_ball_x\",
  \"unit\": \"m\",
  \"value\": \"rocker_pivot_x - 0.011 * s\"
 },
 {
  \"description\": \"Top of the rocker box walls (rocker cover seat)\",
  \"name\": \"rocker_box_top_x\",
  \"unit\": \"m\",
  \"value\": \"rocker_pivot_x + 0.024 * s\"
 },
 {
  \"description\": \"Rocker box half width along the crank axis\",
  \"name\": \"rocker_box_z\",
  \"unit\": \"m\",
  \"value\": \"valve_offset_z + 0.014 * s\"
 },
 {
  \"description\": \"Crank timing sprocket pitch radius (18 teeth); the cam sprocket is twice as large (2:1), driven by the timing chain\",
  \"name\": \"crank_gear_r\",
  \"unit\": \"m\",
  \"value\": \"0.020 * s\"
 },
 {
  \"description\": \"Unused (the idler gears were replaced by the timing chain)\",
  \"name\": \"idler_gear_r\",
  \"unit\": \"m\",
  \"value\": \"crank_gear_r * 16 / 18\"
 },
 {
  \"description\": \"Crank axis to camshaft axis\",
  \"name\": \"cam_distance\",
  \"unit\": \"m\",
  \"value\": \"sqrt(cam_x * cam_x + pushrod_y * pushrod_y)\"
 },
 {
  \"description\": \"Unused (the idler gears were replaced by the timing chain)\",
  \"name\": \"idler_angle\",
  \"unit\": \"deg\",
  \"value\": \"atan2(pushrod_y, cam_x)\"
 },
 {
  \"description\": \"Idler gear centre X\",
  \"name\": \"idler_x\",
  \"unit\": \"m\",
  \"value\": \"(crank_gear_r + idler_gear_r) * cos(idler_angle)\"
 },
 {
  \"description\": \"Idler gear centre Y\",
  \"name\": \"idler_y\",
  \"unit\": \"m\",
  \"value\": \"(crank_gear_r + idler_gear_r) * sin(idler_angle)\"
 },
 {
  \"description\": \"Oil level in the timing gear case (along the cylinder axis; the crank and idler gears dip in it and splash the cam gear)\",
  \"name\": \"timing_oil_level\",
  \"unit\": \"m\",
  \"value\": \"-0.010 * s\"
 },
 {
  \"description\": \"Inner face of the timing gear case cover\",
  \"name\": \"timing_case_z\",
  \"unit\": \"m\",
  \"value\": \"timing_z - timing_width / 2 - 0.0015 * s\"
 },
 {
  \"description\": \"Piston crown to cylinder head at TDC (flat crown, flat head)\",
  \"max\": 0.01,
  \"min\": 0.0005,
  \"name\": \"squish_gap\",
  \"unit\": \"m\",
  \"value\": 0.00268
 },
 {
  \"description\": \"Depth of the valve pockets in the piston crown\",
  \"max\": 0.005,
  \"min\": 0.0,
  \"name\": \"valve_relief_depth\",
  \"unit\": \"m\",
  \"value\": 0.001
 },
 {
  \"description\": \"Depth of the spark plug pocket in the piston crown (clears the plug shell and electrode at TDC)\",
  \"max\": 0.006,
  \"min\": 0.0,
  \"name\": \"plug_relief_depth\",
  \"unit\": \"m\",
  \"value\": 0.0027
 },
 {
  \"description\": \"Top of the tappet bores, where the pushrod tubes start (the tappet stays in its bore at full lift)\",
  \"name\": \"tappet_bore_top_x\",
  \"unit\": \"m\",
  \"value\": \"tappet_top_x + max(intake_lift, exhaust_lift) + 0.002 * s\"
 },
 {
  \"description\": \"Oil level in the crankcase sump (along the cylinder axis; the rod dipper dips in it at BDC)\",
  \"name\": \"crankcase_oil_level\",
  \"unit\": \"m\",
  \"value\": \"-0.048 * s\"
 },
 {
  \"description\": \"Angle of the V: the rear cylinder axis is turned this much from +X about the crank axis (negative = toward the pushrod side, so the pushrods sit between the cylinders)\",
  \"max\": -30.0,
  \"min\": -120.0,
  \"name\": \"vee_angle\",
  \"unit\": \"deg\",
  \"value\": -60
 },
 {
  \"description\": \"cos of the V angle (rear cylinder axis X)\",
  \"name\": \"vc\",
  \"unit\": \"\",
  \"value\": \"cos(vee_angle)\"
 },
 {
  \"description\": \"sin of the V angle (rear cylinder axis Y)\",
  \"name\": \"vs\",
  \"unit\": \"\",
  \"value\": \"sin(vee_angle)\"
 },
 {
  \"description\": \"cos of half the V angle (bisector of the V)\",
  \"name\": \"bis_c\",
  \"unit\": \"\",
  \"value\": \"cos(vee_angle / 2)\"
 },
 {
  \"description\": \"sin of half the V angle (bisector of the V)\",
  \"name\": \"bis_s\",
  \"unit\": \"\",
  \"value\": \"sin(vee_angle / 2)\"
 },
 {
  \"description\": \"Crank angle of the rear cylinder's firing TDC (front cylinder fires at 0): 720 + V gives firing intervals of 720+V and -V (660/60 for V = -60), so at the drawn position (front at firing TDC, rear 60 deg after its firing TDC) every valve is closed\",
  \"name\": \"vee_fire\",
  \"unit\": \"deg\",
  \"value\": \"vee_angle - crank2_deg\"
 },
 {
  \"description\": \"Cooling fins trimmed to this distance from the cylinder axis on the pushrod side\",
  \"name\": \"fin_side\",
  \"unit\": \"m\",
  \"value\": \"R + 0.011 * s\"
 },
 {
  \"description\": \"Unused (fork-and-blade rods were replaced by side-by-side rods)\",
  \"name\": \"blade_half\",
  \"unit\": \"m\",
  \"value\": \"0.0045 * s\"
 },
 {
  \"description\": \"Unused (fork-and-blade rods were replaced by side-by-side rods)\",
  \"name\": \"fork_gap\",
  \"unit\": \"m\",
  \"value\": 0.0005
 },
 {
  \"description\": \"Unused (fork-and-blade rods were replaced by side-by-side rods)\",
  \"name\": \"fork_z\",
  \"unit\": \"m\",
  \"value\": \"(blade_half + fork_gap + big_end_half) / 2\"
 },
 {
  \"description\": \"Bottom of the cylinder liners (above where the two liners of the V would meet)\",
  \"name\": \"liner_base_x\",
  \"unit\": \"m\",
  \"value\": \"max(case_outer_r - 0.012 * s, liner_out / abs(tan(vee_angle / 2)) + 0.002)\"
 },
 {
  \"description\": \"Rear wrist pin distance from the crank axis as drawn (crank at the front cylinder's TDC)\",
  \"name\": \"piston2_d\",
  \"unit\": \"m\",
  \"value\": \"r * cos(vee_angle - crank2_deg) + sqrt(rod_length^2 - (r * sin(vee_angle - crank2_deg))^2)\"
 },
 {
  \"description\": \"Rear connecting rod direction as drawn (from +X)\",
  \"name\": \"rod2_angle\",
  \"unit\": \"deg\",
  \"value\": \"atan2(piston2_d * vs - r * sin(crank2_deg), piston2_d * vc - r * cos(crank2_deg))\"
 },
 {
  \"description\": \"Unused (one central camshaft serves both cylinders)\",
  \"name\": \"cam2_x\",
  \"unit\": \"m\",
  \"value\": \"cam_x * vc + pushrod_y * vs\"
 },
 {
  \"description\": \"Unused (one central camshaft serves both cylinders)\",
  \"name\": \"cam2_y\",
  \"unit\": \"m\",
  \"value\": \"cam_x * vs - pushrod_y * vc\"
 },
 {
  \"description\": \"Unused (the idler gears were replaced by the timing chain)\",
  \"name\": \"idler2_x\",
  \"unit\": \"m\",
  \"value\": \"idler_x * vc + idler_y * vs\"
 },
 {
  \"description\": \"Unused (the idler gears were replaced by the timing chain)\",
  \"name\": \"idler2_y\",
  \"unit\": \"m\",
  \"value\": \"idler_x * vs - idler_y * vc\"
 },
 {
  \"description\": \"Angle of the front cylinder's magneto core (from +X); the rear core sits vee_angle further\",
  \"name\": \"magneto_core_deg\",
  \"unit\": \"deg\",
  \"value\": 120
 },
 {
  \"description\": \"Fins of each cylinder are trimmed this far from the V bisector plane\",
  \"name\": \"vee_fin_gap\",
  \"unit\": \"m\",
  \"value\": 0.001
 },
 {
  \"description\": \"First barrel fin (lower face) along the cylinder axis; fins every 8.5 mm * s\",
  \"name\": \"fin0_x\",
  \"unit\": \"m\",
  \"value\": \"max(case_outer_r + 0.014 * s, (fin_side + vee_fin_gap / bis_c) * bis_c / abs(bis_s) + 0.001)\"
 },
 {
  \"description\": \"Rear cylinder offset along the crank axis (+Z, magneto side): the two rods sit side by side on the crank pin\",
  \"name\": \"cyl_dz\",
  \"unit\": \"m\",
  \"value\": \"2 * big_end_half + 0.001\"
 },
 {
  \"description\": \"Magneto-side crank web inner face (the crank pin carries both rods)\",
  \"name\": \"web_in_m\",
  \"unit\": \"m\",
  \"value\": \"web_in + cyl_dz\"
 },
 {
  \"description\": \"Magneto-side crank web outer face\",
  \"name\": \"web_out_m\",
  \"unit\": \"m\",
  \"value\": \"web_out + cyl_dz\"
 },
 {
  \"description\": \"Crankcase inner wall on the magneto side\",
  \"name\": \"case_inner_z_m\",
  \"unit\": \"m\",
  \"value\": \"case_inner_z + cyl_dz\"
 },
 {
  \"description\": \"Crankcase outer wall on the magneto side\",
  \"name\": \"case_outer_z_m\",
  \"unit\": \"m\",
  \"value\": \"case_outer_z + cyl_dz\"
 },
 {
  \"description\": \"Central camshaft distance from the crank axis, on the V bisector (one camshaft, four lobes, for both cylinders)\",
  \"name\": \"cam_rho\",
  \"unit\": \"m\",
  \"value\": \"0.15 * s\"
 },
 {
  \"description\": \"Inner wall of the timing chain case (just beyond the cylinder fins)\",
  \"name\": \"timing_wall_z\",
  \"unit\": \"m\",
  \"value\": \"-(fin_r + 0.0005)\"
 },
 {
  \"description\": \"Height (along the crank axis) of the intake crossover that joins both intake runners to the carburettor\",
  \"name\": \"im_z\",
  \"unit\": \"m\",
  \"value\": \"R + 0.080 * s\"
 },
 {
  \"description\": \"Front intake runner end (crossover joint) X\",
  \"name\": \"im1_x\",
  \"unit\": \"m\",
  \"value\": \"port_x + 0.006\"
 },
 {
  \"description\": \"Front intake runner end (crossover joint) Y\",
  \"name\": \"im1_y\",
  \"unit\": \"m\",
  \"value\": \"port_back + 0.016\"
 },
 {
  \"description\": \"Rear intake runner end X (mirror about the V bisector)\",
  \"name\": \"im2_x\",
  \"unit\": \"m\",
  \"value\": \"im1_x * vc + im1_y * vs\"
 },
 {
  \"description\": \"Rear intake runner end Y\",
  \"name\": \"im2_y\",
  \"unit\": \"m\",
  \"value\": \"im1_x * vs - im1_y * vc\"
 },
 {
  \"description\": \"Length of the intake crossover\",
  \"name\": \"im_len\",
  \"unit\": \"m\",
  \"value\": \"sqrt((im2_x - im1_x)^2 + (im2_y - im1_y)^2)\"
 },
 {
  \"description\": \"Exhaust 2-into-1 collector: distance behind the crank axis, on the V bisector (opposite the V)\",
  \"name\": \"exh_k\",
  \"unit\": \"m\",
  \"value\": \"0.10 * s\"
 },
 {
  \"description\": \"Unused (with the 660/60 firing order every valve is closed at the drawn position)\",
  \"name\": \"rear_intake_rest_lift\",
  \"unit\": \"m\",
  \"value\": 0.007
 },
 {
  \"description\": \"Unused (rear intake train drawn closed with the 660/60 firing order)\",
  \"name\": \"rl_t\",
  \"unit\": \"m\",
  \"value\": \"rear_intake_rest_lift + 0.00005\"
 },
 {
  \"description\": \"Unused (rear intake train drawn closed with the 660/60 firing order)\",
  \"name\": \"rl_th\",
  \"unit\": \"deg\",
  \"value\": \"asin((rl_t - (rocker_pivot_x - adjuster_ball_x) * (1 - cos(asin(rl_t / abs(pushrod_y - rocker_pivot_y))))) / abs(pushrod_y - rocker_pivot_y))\"
 },
 {
  \"description\": \"Unused (rear intake train drawn closed with the 660/60 firing order)\",
  \"name\": \"rl_v\",
  \"unit\": \"m\",
  \"value\": \"abs(pushrod_y - rocker_pivot_y) * sin(rl_th) - valve_lash\"
 },
 {
  \"description\": \"Unused (rear intake train drawn closed with the 660/60 firing order)\",
  \"name\": \"rl_ax\",
  \"unit\": \"m\",
  \"value\": \"adjuster_ball_x - tappet_top_x - rl_t + (rocker_pivot_x - adjuster_ball_x) * (1 - cos(rl_th)) + abs(pushrod_y - rocker_pivot_y) * sin(rl_th)\"
 },
 {
  \"description\": \"Unused (rear intake train drawn closed with the 660/60 firing order)\",
  \"name\": \"rl_lat\",
  \"unit\": \"m\",
  \"value\": \"abs(pushrod_y - rocker_pivot_y) * (1 - cos(rl_th)) - (rocker_pivot_x - adjuster_ball_x) * sin(rl_th)\"
 },
 {
  \"description\": \"Rear crank pin angle as drawn (front pin at 0): split crank pin; equal to vee_angle puts both pistons at TDC together\",
  \"name\": \"crank2_deg\",
  \"unit\": \"deg\",
  \"value\": \"vee_angle\"
 }
]"""
