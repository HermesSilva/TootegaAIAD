    def Scope "Elements"
    {
        def Scope "Crank_friction_and_load"
        {
            custom string aiad:definition = '{"constant":"0.97e5 * bore^2 * stroke / 16","joint":"Main bearing","linear":"0.15e5 * bore^2 * stroke / 16 * 30 / (pi * 1000)","quadratic":"0.05e5 * bore^2 * stroke / 16 * (30 / (pi * 1000))^2 + load_coefficient"}'
            custom string aiad:name = "Crank friction and load"
            custom string aiad:type = "load"
        }

        def Scope "Intake_cam"
        {
            custom string aiad:definition = '{"body":"IntakeTappet","normal":[-1,0,0],"part":"Intake lobe","point":["tappet_bottom_x","pushrod_y","valve_offset_z"],"radius":"0.011 * s"}'
            custom string aiad:name = "Intake cam"
            custom string aiad:type = "contact"
        }

        def Scope "Exhaust_cam"
        {
            custom string aiad:definition = '{"body":"ExhaustTappet","normal":[-1,0,0],"part":"Exhaust lobe","point":["tappet_bottom_x","pushrod_y","-valve_offset_z"],"radius":"0.011 * s"}'
